PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
JWT_SECRET=change-this-to-a-very-long-random-secret-in-production
JWT_EXPIRES_IN=7d
MAX_FILE_SIZE=10485760
LOG_LEVEL=debug

# Optional: used only to phrase crop-advisory explanations (scores never depend on it)
GEMINI_API_KEY=

# Optional email notifications (leave SMTP_HOST empty to disable; in-app notifications always work)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Saara Ketha Harvest Hub <no-reply@harvesthub.lk>
